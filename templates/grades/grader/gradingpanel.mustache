{{!
    @template gradingform_singlepoint/grades/grader/gradingpanel

    The single-point rubric in the forum grader's side panel.

    Example context (json):
    {
        "instanceid": 42,
        "scoring": "Meets and Beyond earn the criterion's points. Not yet earns 0%.",
        "criteria": [{
            "id": 4, "name": "Thesis", "description": "<p>States a clear, arguable claim.</p>", "maxscore": 10,
            "remark": "",
            "levels": [{"value": 0, "label": "Not yet", "checked": false},
                       {"value": 1, "label": "Meets", "checked": true},
                       {"value": 2, "label": "Beyond", "checked": false}]
        }]
    }
}}
<form id="gradingform_singlepoint-{{uniqid}}">
    <input type="hidden" name="instanceid" value="{{instanceid}}">
    <p class="text-muted small">{{scoring}}</p>
    {{#criteria}}
    <fieldset class="mb-3 criterion">
        <legend class="h5 mb-1"><strong>{{name}}</strong> <span class="text-muted small">({{#str}}pointscount, gradingform_singlepoint, {{maxscore}}{{/str}})</span></legend>
        <div class="small mb-2">{{{description}}}</div>
        <div class="mb-2">
            {{#levels}}
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="advancedgrading[criteria][{{id}}][level]"
                    id="gradingform_singlepoint-{{uniqid}}-{{id}}-{{value}}" value="{{value}}" {{#checked}}checked{{/checked}}>
                <label class="form-check-label" for="gradingform_singlepoint-{{uniqid}}-{{id}}-{{value}}"><span class="gradingform_singlepoint-sronly">{{name}}: </span>{{label}}</label>
            </div>
            {{/levels}}
        </div>
        <label class="gradingform_singlepoint-sronly" for="gradingform_singlepoint-{{uniqid}}-{{id}}-remark">{{#str}}commenton, gradingform_singlepoint, {{name}}{{/str}}</label>
        <textarea class="form-control" rows="2" name="advancedgrading[criteria][{{id}}][remark]"
            id="gradingform_singlepoint-{{uniqid}}-{{id}}-remark">{{remark}}</textarea>
    </fieldset>
    {{/criteria}}
</form>
